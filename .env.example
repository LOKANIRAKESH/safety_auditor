# Environment configuration for Safety Auditor
# Copy this file to .env and adjust values for your setup:
#   copy .env.example .env

# ── LLM via Ollama ──────────────────────────────────────────
LLM_MODEL=qwen2.5
LLM_FALLBACK_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

# ── Extraction thresholds ───────────────────────────────────
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# ── Cross-modal entity linking ──────────────────────────────
# Set to false to run the ablation study (no cross-modal linking)
ENABLE_CROSS_MODAL_LINKING=true
FUZZY_MATCH_THRESHOLD=85
EMBEDDING_SIMILARITY_THRESHOLD=0.75

# ── Z3 SMT solver ───────────────────────────────────────────
Z3_TIMEOUT_MS=5000

# ── Report format ───────────────────────────────────────────
# html  → opens in browser (default, no extra dependencies)
# pdf   → requires weasyprint: pip install weasyprint
REPORT_FORMAT=html

# ── Tesseract OCR (for P&ID extraction) ────────────────────
# Windows default install path — adjust if different
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac:
# TESSERACT_CMD=/usr/bin/tesseract
