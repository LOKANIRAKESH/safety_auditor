(* Amrita Vishwa Vidyapeetham M.Tech Research — {{ program_name }} *)
(* WARNING: Verify all logic with a qualified ICS safety engineer before deployment *)

PROGRAM {{ program_name }}
VAR
{% for equip_id, rules in equipment_rules.items() %}
    (* --- {{ equip_id }} --- *)
{% for rule in rules %}
    {{ rule.condition.sensor_tag | replace('-','_') }}_val : REAL;
{% endfor %}
    {{ equip_id | replace('-','_') }}_CMD : BOOL;
{% endfor %}
    ESD_ACTIVE : BOOL := FALSE;
END_VAR

(* === EMERGENCY SHUTDOWN PROPAGATION === *)
(* If ESD is active, all equipment must be in safe state *)
IF ESD_ACTIVE THEN
{% for equip_id in equipment_rules.keys() %}
    {{ equip_id | replace('-','_') }}_CMD := FALSE;  (* STOP / CLOSE *)
{% endfor %}
    RETURN;
END_IF;

(* === EQUIPMENT-LEVEL INTERLOCK LOGIC === *)
{% for equip_id, rules in equipment_rules.items() %}

(* -- {{ equip_id }} -- *)
{% for rule in rules %}
(* Rule {{ rule.rule_id }}: IF {{ rule.condition }} THEN {{ equip_id }} {{ rule.action.value }}
   Source: {{ rule.source_doc }} p.{{ rule.source_page }} [conf={{ "%.2f"|format(rule.confidence) }}] *)
IF {{ rule.condition.sensor_tag | replace('-','_') }}_val {{ rule.condition.operator.value }} {{ rule.condition.threshold }} THEN
{% if rule.action.value in ('STOP', 'CLOSE') %}
    {{ equip_id | replace('-','_') }}_CMD := FALSE;
{% elif rule.action.value in ('START', 'OPEN') %}
    {{ equip_id | replace('-','_') }}_CMD := TRUE;
{% elif rule.action.value == 'ALARM' %}
    (* ALARM: {{ equip_id }} — {{ rule.condition }} *)
    {{ equip_id | replace('-','_') }}_CMD := {{ equip_id | replace('-','_') }}_CMD;  (* no state change, alarm only *)
{% endif %}
END_IF;
{% endfor %}
{% endfor %}

END_PROGRAM
